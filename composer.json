{
  "name": "zanko-khaledi/notifications",
  "description": "A Laravel notification service for synchronous and asynchronous notifications with queued jobs and notification pooling.",
  "type": "library",
  "keywords": [
    "laravel",
    "laravel-notifications",
    "notifications",
    "php",
    "notification",
    "async-notifications",
    "asynchronous-notifications",
    "queued-notifications",
    "queue",
    "laravel-queue",
    "notification-service",
    "notification-pool",
    "notification-driver",
    "notification-interface",
    "laravel-package",
    "php-package",
    "backend",
    "messaging"
  ],
  "require": {
    "php": "^8.2.0",
    "illuminate/support": ">=11.0",
    "illuminate/database": ">=11.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ZankoKhaledi\\Notifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ZankoKhaledi\\Notifications\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "zanko khaledi",
      "email": "zanko.kh75@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "ZankoKhaledi\\Notifications\\NotificationServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "require-dev": {
    "orchestra/testbench": "10.x-dev",
    "pestphp/pest": "4.x-dev"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}