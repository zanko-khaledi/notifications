{
  "name": "zanko-khaledi/notifications",
  "description": "A Laravel notification service for synchronous and asynchronous notifications with queued jobs and notification pooling.",
  "type": "library",
  "keywords": [
    "laravel",
    "php",
    "notifications",
    "laravel-notifications",
    "async-notifications",
    "queued-notifications",
    "laravel-queue",
    "notification-service",
    "notification-pool",
    "notification-driver",
    "laravel-package"
  ],
  "homepage": "https://github.com/zanko-khaledi/notifications",
  "support": {
    "issues": "https://github.com/zanko-khaledi/notifications/issues"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "zanko khaledi",
      "email": "zanko.kh75@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "ZankoKhaledi\\Notifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ZankoKhaledi\\Notifications\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ZankoKhaledi\\Notifications\\NotificationServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}